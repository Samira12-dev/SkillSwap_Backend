# Copy this file to .env and replace every placeholder with a strong, unique value.
# Never commit .env or any file containing real credentials.

DB_URL=jdbc:mysql://mysql:3306/skillswap_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=skillswap_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=3600000

# Keep disabled in production
SHOW_SQL=false
SPRINGDOC_ENABLED=false

WS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads

# Gmail SMTP (use a Gmail App Password, never the account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Optional. Use the authenticated Gmail address; if omitted, it is the sender.
MAIL_FROM=${MAIL_USERNAME}
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRATION_MS=86400000
